{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: uvicorn (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["cms_platform.api.main:app", "--reload", "--port", "8000"],
      "env": { "CMS_API_KEY": "dev-local-key" },
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Ingest: config-driven loader",
      "type": "debugpy",
      "request": "launch",
      "module": "cms_platform.ingest.loader",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Analysis: ED/HVBP finding",
      "type": "debugpy",
      "request": "launch",
      "module": "cms_platform.analysis.ed_hvbp_finding",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "pytest: full suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
